# infra_cod environment variables (no secret values).
#
# This file documents the variables and where each one belongs in production.
# Nothing here is read by the code: copy the relevant lines into the local
# development files, or into the systemd units (`Environment=`), and never commit
# real secret values.
#
# Production keeps the tiers in separate files, because the processes do not
# share a trust boundary:
#
#   /etc/infra-cod/database.env   root:root 0640, root-owned   — read by the DB
#                                 clients: web, workers, migrator, backup.
#                                 Connection target only, no per-process role and
#                                 no password: roles differ per unit.
#   /etc/infra-cod/web.env        root:infra-web 0640          — the web secrets
#                                 (pepper, OAuth code encryption key). Never
#                                 readable by a worker or a runtime user.
#   /etc/infra-cod/github-app.env root:infra-cod-github 0640   — the GitHub App
#                                 credentials. Only the broker reads it; the web
#                                 tier must never see the client secret or key.
#
# Locally the same values live in two gitignored files, because Next.js reads env
# files from the app directory:
#   .env.local            — the services, the migrator and `infra-cod admin`
#   apps/web/.env.local   — the subset the web tier reads
# Keep INFRA_COD_AUTH_PEPPER identical in both: it is baked into every stored
# password hash, so changing or losing it locks every operator out.

# --- Database connection (shared: web, workers, migrator, backup) ---
#
# Local development uses a URL. Production has none: it reaches PostgreSQL by
# peer authentication over the Unix socket, where the OS user and the database
# role are mapped 1:1 in pg_ident.conf and no password exists at all. There is no
# `DATABASE_URL` and no `PGPASSWORD` anywhere in production — a password-bearing
# URL would be a second, weaker authentication path beside the peer mapping.
DATABASE_URL=
#
# `npm run check` runs three suites against this database: the Node integration
# tests, the migration-upgrade-path test, and 31 rollback-only SQL files. Two
# preconditions, and neither is optional:
#
#   1. The migrations are applied. `npm run db:migrate` first. A database behind the
#      repository fails the suite in a way that reads like a schema bug.
#   2. Nothing else has queued work. `db/tests/0022` asserts that the refresh it
#      requests is the *next* job `claim_catalog_refresh_work` returns, and that
#      function orders by `created_at` across all connections. A pending
#      `settings_refresh` row left by a running panel is older, so it is claimed
#      first and the assertion fails with "manual refresh job was not claimed" —
#      which is what happened to this repository's development database after the
#      panel had been used. Point the gate at a scratch database, or clear
#      `control_plane.catalog_refresh_jobs`, before investigating a failure here.
#
# The production form, in /etc/infra-cod/database.env. Only the two coordinates
# the whole tier shares are set here; PGUSER is deliberately NOT in this file —
# each unit sets its own role, so `infra_web`, `infra_worker` and `infra_backup`
# stay distinct instead of every process inheriting whichever role the file named.
# PGHOST is explicit because every unit sets PrivateTmp=true, which gives the
# process a private /tmp where the default socket does not exist.
# PGHOST=/var/run/postgresql
# PGDATABASE=infra_cod
#
# Per unit, in the unit itself:
#   infra-cod-web.service                     PGUSER=infra_web
#   every DB-backed worker                    PGUSER=infra_worker
#   infra-cod-backup.service                  PGUSER=infra_backup
#   install/migrate/admin (root, one-shot)    PGUSER=infra_migrator
#
# Names the actor in `infra-cod admin` audit rows (cli:<value>). Only needed when
# the process is not under sudo and the OS user is not the operator — a unit, say.
# INFRA_COD_ACTOR=installer
# Overrides where bootstrap writes initial-credentials. The default,
# /etc/infra-cod, is root-owned and retired by the root health timer.
# INFRA_COD_CREDENTIALS_DIR=/etc/infra-cod

# --- Web tier (Next.js standalone, 127.0.0.1:3100 behind Caddy) ---
#
# Public origin of the panel, for example https://panel.example.com. Mutating
# requests are checked against it, so it must match what the browser sees.
# Runtime-only, not NEXT_PUBLIC_*: one standalone artifact is installed on
# different domains without a rebuild. Required in production, where it must be
# an https:// origin; the process refuses to start otherwise rather than guessing
# the origin from the request's Host header.
INFRA_COD_SITE_URL=http://localhost:3000
# Stable across restarts, and never committed. Peppers password hashes and the
# client-address digests in web_sessions; losing it locks every operator out, so
# back it up with the database. Generate with: openssl rand -base64 32.
# Lives in the root-owned web env: a runtime agent user must not be able to read
# it, because with it the stored hashes stop being one-way.
INFRA_COD_AUTH_PEPPER=
# Development only: drops Secure from the session and CSRF cookies so
# http://localhost works. The application refuses to start when this is set
# together with NODE_ENV=production.
# INFRA_COD_INSECURE_COOKIES=1
# GitHub App slug used to build the browser install URL. Not secret.
GITHUB_APP_SLUG=
# GitHub App OAuth client id — used by the callback route to record the
# authorization code row. The secret must NEVER be set in the web environment.
GITHUB_APP_CLIENT_ID=
# Dedicated 32-byte AES key encoded as 64 hex characters. The callback uses it
# only to encrypt one-time OAuth codes before database persistence. Generate
# with: openssl rand -hex 32. A web secret: it belongs with the pepper, not with
# the services.
GITHUB_OAUTH_CODE_ENCRYPTION_KEY=

# --- Control-plane services (workers, dispatcher, supervisor) ---
CONTROL_PLANE_DB=infra_cod
PROJECT_WORKSPACE_ROOT=/srv/infra-cod-handoff-poc/workspaces

# --- GitHub App credential broker (github-app-worker only) ---
# GitHub App numeric ID (from the app's settings page). Not secret.
GITHUB_APP_ID=
# OAuth client id + client secret. The secret must NEVER leave the VPS and
# must NEVER be set in the web environment.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Must match the web value so the broker can decrypt the one-time code.
GITHUB_OAUTH_CODE_ENCRYPTION_KEY=
# App slug (must match GITHUB_APP_SLUG used by the web layer).
# GITHUB_APP_SLUG=
# Broker worker identity and cadence.
GITHUB_APP_WORKER_ID=github-app-broker-1
GITHUB_APP_WORKER_POLL_MS=60000
GITHUB_APP_CLONE_TIMEOUT_MS=180000
# Workspace ownership handed to the runtime worker users after clone.
GITHUB_APP_WORKSPACE_USER=codex-poc
GITHUB_APP_WORKSPACE_GROUP=agent-workspace
# Private key location. The file MUST be owned by root:infra-cod-github mode 0640
# (or root:root 0600 when the broker runs as root) and never be readable by
# codex-poc / opencode runtime users. Never put the key contents in this file.
GITHUB_APP_PRIVATE_KEY_PATH=/etc/infra-cod/github-app/private-key.pem
# Optional: override the GitHub REST API version (default 2022-11-28).
# GITHUB_API_VERSION=2022-11-28
# Tests only: inject the key inline instead of reading the file. Never set in production.
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_ALLOW_INLINE_PRIVATE_KEY=1
