[Unit]
Description=infra_cod durable orchestrator worker
After=network-online.target postgresql@17-main.service infra-cod-runtime-supervisor.service
Wants=network-online.target
Wants=postgresql@17-main.service infra-cod-runtime-supervisor.service

PartOf=infra-cod.target

[Service]
Type=simple
User=infra-control
Group=infra-control
WorkingDirectory=/opt/infra-cod/current
Environment=CONTROL_PLANE_DB=infra_cod
EnvironmentFile=-/etc/infra-cod/database.env
Environment=PGUSER=infra_worker
Environment=RUNTIME_SUPERVISOR_SOCKET=/run/infra-cod/runtime-supervisor.sock
Environment=ORCHESTRATOR_WORKER_ID=vps-orchestrator-worker-1
Environment=ORCHESTRATOR_POLL_MS=15000
ExecStart=/opt/node/bin/node /opt/infra-cod/current/services/control-plane/orchestrator-worker.mjs
Restart=on-failure
TimeoutStopSec=20
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
