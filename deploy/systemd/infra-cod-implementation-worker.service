[Unit]
Description=infra_cod durable implementation worker
After=network-online.target postgresql@17-main.service infra-cod-runtime-supervisor.service
Wants=network-online.target
Wants=postgresql@17-main.service infra-cod-runtime-supervisor.service

PartOf=infra-cod.target

[Service]
Type=simple
User=infra-control
Group=infra-control
WorkingDirectory=/opt/infra-cod/current
Environment=CONTROL_PLANE_DB=infra_cod
EnvironmentFile=-/etc/infra-cod/database.env
Environment=PGUSER=infra_worker
Environment=RUNTIME_SUPERVISOR_SOCKET=/run/infra-cod/runtime-supervisor.sock
Environment=EXECUTOR_WORKER_ID=vps-runtime-supervisor-1
Environment=EXECUTOR_POLL_MS=15000
# The same value the supervisor enforces. This side waits it out plus a margin,
# so the supervisor's timer is the one that fires: it can name itself and stop
# the child, and this side can only stop waiting. Ten minutes here against five
# in the supervisor was harmless; ten against sixty made the worker abandon a run
# that was still writing, and retry into the same workspace.
Environment=RUNTIME_RUN_TIMEOUT_MS=3600000
ExecStart=/opt/node/bin/node /opt/infra-cod/current/services/control-plane/implementation-worker.mjs
Restart=on-failure
TimeoutStopSec=20
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
