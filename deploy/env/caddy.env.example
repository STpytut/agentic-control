# /etc/infra-cod/caddy.env - what the edge needs to know.
#
# Installed as root:caddy 0640. Set the block for the mode named by
# INFRA_COD_CADDY_CONFIG in infra-cod-caddy.service, and leave the other unset:
# Caddy's Caddyfile placeholder syntax has no "must be set" enforcement, so a
# variable that is present but wrong is worse than one that is absent and obvious.

# --- public domain mode: INFRA_COD_CADDY_CONFIG=/etc/infra-cod/caddy/Caddyfile ---
# The DNS name the panel is served from. Caddy obtains and renews an ACME
# certificate for it, redirects http to https, and sets HSTS.
INFRA_COD_DOMAIN=
# Contact address for the ACME account.
INFRA_COD_ACME_EMAIL=

# --- local acceptance mode: .../caddy/Caddyfile.local ---
# Plain HTTP, no certificates, no HSTS. Use it only for a clean-room run with no
# public DNS. The panel must then also be reachable at this origin, and because it
# is http the panel has to run with INFRA_COD_INSECURE_COOKIES=1 and NODE_ENV
# development - the `__Host-` cookie prefix requires Secure, and a production
# build refuses that flag.
# INFRA_COD_HOST=127.0.0.1
# INFRA_COD_PORT=8080

# The ceiling on a request body, applied by Caddy in front of the panel. The
# default, 5MB, is documented in the Caddyfile next to the panel's own limit.
# INFRA_COD_MAX_BODY=5MB
