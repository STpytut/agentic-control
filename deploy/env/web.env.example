# /etc/infra-cod/web.env - the web tier's own secrets.
#
# Installed as root:infra-web 0640: readable by the panel's OS user, and by
# nothing else. It is a separate file from database.env precisely because of the
# pepper: it keys every stored password hash and the client-address digests in
# web_sessions, so a worker, the GitHub broker, or a runtime agent user that could
# read it would hold something that turns the stored hashes back into a usable
# credential. None of them can read this file.
#
# It is also separate from github-app.env: the web tier must never see the GitHub
# App client secret or private key, and .env.example says so.

# The panel's public origin, for example https://panel.example.com. Mutating
# requests are checked against it, so it must be exactly what a browser sees, and
# it must match the Caddy configuration. Required: the process refuses to start in
# production when it is missing or is not an https:// origin, rather than guessing
# the origin from the request's Host header. Changing the domain is a change to
# this file and to the Caddyfile - never a rebuild of the standalone tree.
INFRA_COD_SITE_URL=

# Stable across restarts, and never regenerated: it is baked into every stored
# password hash, so losing it locks every operator out. Back it up with the
# database. Generate once with: openssl rand -base64 32
INFRA_COD_AUTH_PEPPER=

# Dedicated 32-byte AES key, 64 hex characters, used only to encrypt one-time
# OAuth authorization codes before they are persisted. Generate with:
# openssl rand -hex 32
GITHUB_OAUTH_CODE_ENCRYPTION_KEY=

# GitHub App slug and OAuth client id. Not secret; the slug builds the browser
# install URL and the client id is sent in the OAuth authorize redirect. The
# client SECRET belongs in github-app.env only.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
