{
  "$description": "Agentic design tokens — the single source of truth. Edit this file, then run `npm run build:tokens`. Primitives are raw values; semantic tokens reference primitives with {primitive.path} and carry a light and a dark value.",

  "primitive": {
    "color": {
      "paper": { "$type": "color", "$value": "#f4f3ef", "$description": "Warm off-white ground of every product." },
      "ink": {
        "900": { "$type": "color", "$value": "#111111", "$description": "Primary text and primary controls." },
        "800": { "$type": "color", "$value": "#171717", "$description": "Dark surfaces (footer, dark sections)." },
        "600": { "$type": "color", "$value": "#666666", "$description": "Secondary text on paper." },
        "300": { "$type": "color", "$value": "#a3a29e", "$description": "Secondary text on dark surfaces." }
      },
      "lime": {
        "400": { "$type": "color", "$value": "#c8ff3d", "$description": "The brand accent. Never used for body text on paper." }
      },
      "ink-alpha": {
        "6": { "$type": "color", "$value": "rgba(17, 17, 17, 0.06)" },
        "7": { "$type": "color", "$value": "rgba(17, 17, 17, 0.07)" },
        "12": { "$type": "color", "$value": "rgba(17, 17, 17, 0.12)" },
        "24": { "$type": "color", "$value": "rgba(17, 17, 17, 0.24)" },
        "40": { "$type": "color", "$value": "rgba(17, 17, 17, 0.40)" }
      },
      "paper-alpha": {
        "8": { "$type": "color", "$value": "rgba(244, 243, 239, 0.08)" },
        "10": { "$type": "color", "$value": "rgba(244, 243, 239, 0.10)" },
        "16": { "$type": "color", "$value": "rgba(244, 243, 239, 0.16)" },
        "40": { "$type": "color", "$value": "rgba(244, 243, 239, 0.40)" }
      },
      "black-alpha": {
        "60": { "$type": "color", "$value": "rgba(0, 0, 0, 0.60)" }
      },
      "green": {
        "700": { "$type": "color", "$value": "#2d6a3e" },
        "300": { "$type": "color", "$value": "#8fd19e" },
        "100": { "$type": "color", "$value": "#dfe8d8" },
        "950": { "$type": "color", "$value": "#28312a" }
      },
      "amber": {
        "700": { "$type": "color", "$value": "#8a5300" },
        "300": { "$type": "color", "$value": "#f0c36b" },
        "100": { "$type": "color", "$value": "#f2e3c2" },
        "950": { "$type": "color", "$value": "#352f23" }
      },
      "red": {
        "700": { "$type": "color", "$value": "#a3301e" },
        "300": { "$type": "color", "$value": "#f29a86" },
        "100": { "$type": "color", "$value": "#f3dad3" },
        "950": { "$type": "color", "$value": "#362926" }
      },
      "blue": {
        "700": { "$type": "color", "$value": "#2e4d78" },
        "300": { "$type": "color", "$value": "#9db8e0" },
        "100": { "$type": "color", "$value": "#dce2ea" },
        "950": { "$type": "color", "$value": "#2a2e33" }
      }
    }
  },

  "color": {
    "canvas": { "$type": "color", "light": "{primitive.color.paper}", "dark": "{primitive.color.ink.800}", "$description": "Page ground and card fill.", "figma": "bg/canvas" },
    "wash": { "$type": "color", "light": "{primitive.color.ink-alpha.6}", "dark": "{primitive.color.paper-alpha.8}", "$description": "Hover fill for rows, menu items and nav.", "figma": "bg/wash" },
    "skeleton": { "$type": "color", "light": "{primitive.color.ink-alpha.7}", "dark": "{primitive.color.paper-alpha.10}", "$description": "Loading placeholders.", "figma": "bg/skeleton" },
    "overlay": { "$type": "color", "light": "{primitive.color.ink-alpha.40}", "dark": "{primitive.color.black-alpha.60}", "$description": "Scrim behind dialogs and slide-overs.", "figma": "bg/overlay" },
    "inverse": { "$type": "color", "light": "{primitive.color.ink.800}", "dark": "{primitive.color.paper}", "$description": "Inverted surface (footer, dark section).", "figma": "bg/inverse" },
    "ink": { "$type": "color", "light": "{primitive.color.ink.900}", "dark": "{primitive.color.paper}", "$description": "Primary text, primary button fill, active nav fill.", "figma": "fg/ink" },
    "muted": { "$type": "color", "light": "{primitive.color.ink.600}", "dark": "{primitive.color.ink.300}", "$description": "Secondary text, hints, meta.", "figma": "fg/muted" },
    "on-ink": { "$type": "color", "light": "{primitive.color.paper}", "dark": "{primitive.color.ink.900}", "$description": "Text placed on an ink fill.", "figma": "fg/on-ink" },
    "accent": { "$type": "color", "light": "{primitive.color.lime.400}", "dark": "{primitive.color.lime.400}", "$description": "Brand accent fill: hover of primary, attention badge, selection, centre node of the mark.", "figma": "accent/fill" },
    "on-accent": { "$type": "color", "light": "{primitive.color.ink.900}", "dark": "{primitive.color.ink.900}", "$description": "Text on the accent fill. Always ink.", "figma": "accent/on-accent" },
    "accent-text": { "$type": "color", "light": "{primitive.color.ink.900}", "dark": "{primitive.color.lime.400}", "$description": "Accent used as a text colour — only legible on dark, so it falls back to ink on paper.", "figma": "accent/text" },
    "line": { "$type": "color", "light": "{primitive.color.ink-alpha.12}", "dark": "{primitive.color.paper-alpha.16}", "$description": "Hairline borders and rules.", "figma": "border/line" },
    "line-strong": { "$type": "color", "light": "{primitive.color.ink-alpha.24}", "dark": "{primitive.color.paper-alpha.40}", "$description": "Input borders, secondary button, dashed empty states.", "figma": "border/line-strong" },
    "focus": { "$type": "color", "light": "{primitive.color.ink.900}", "dark": "{primitive.color.lime.400}", "$description": "Focus ring.", "figma": "border/focus" },

    "success": { "$type": "color", "light": "{primitive.color.green.700}", "dark": "{primitive.color.green.300}", "$description": "Success text/icon. Always paired with a text label.", "figma": "status/success" },
    "success-soft": { "$type": "color", "light": "{primitive.color.green.100}", "dark": "{primitive.color.green.950}", "figma": "status/success-soft" },
    "warning": { "$type": "color", "light": "{primitive.color.amber.700}", "dark": "{primitive.color.amber.300}", "figma": "status/warning" },
    "warning-soft": { "$type": "color", "light": "{primitive.color.amber.100}", "dark": "{primitive.color.amber.950}", "figma": "status/warning-soft" },
    "danger": { "$type": "color", "light": "{primitive.color.red.700}", "dark": "{primitive.color.red.300}", "figma": "status/danger" },
    "danger-soft": { "$type": "color", "light": "{primitive.color.red.100}", "dark": "{primitive.color.red.950}", "figma": "status/danger-soft" },
    "info": { "$type": "color", "light": "{primitive.color.blue.700}", "dark": "{primitive.color.blue.300}", "figma": "status/info" },
    "info-soft": { "$type": "color", "light": "{primitive.color.blue.100}", "dark": "{primitive.color.blue.950}", "figma": "status/info-soft" }
  },

  "compat": {
    "$description": "Constant (non-theming) names kept so Agentic Marketing and Agentic Lab migrate without renaming classes.",
    "ink-dark": { "$type": "color", "$value": "{primitive.color.ink.800}" },
    "line-dark": { "$type": "color", "$value": "{primitive.color.paper-alpha.16}" }
  },

  "radius": {
    "xs": { "$type": "dimension", "$value": 6, "$description": "Skeleton bars, tiny marks." },
    "sm": { "$type": "dimension", "$value": 8, "$description": "Badges, chips, menu items." },
    "md": { "$type": "dimension", "$value": 10, "$description": "Buttons, inputs, nav items." },
    "lg": { "$type": "dimension", "$value": 14, "$description": "Cards, popovers, dialogs." },
    "full": { "$type": "dimension", "$value": 9999 }
  },

  "space": {
    "$description": "4px grid. Tailwind's default spacing scale already matches; these names are for Figma and non-Tailwind consumers.",
    "0-5": { "$type": "dimension", "$value": 2 },
    "1": { "$type": "dimension", "$value": 4 },
    "1-5": { "$type": "dimension", "$value": 6 },
    "2": { "$type": "dimension", "$value": 8 },
    "2-5": { "$type": "dimension", "$value": 10 },
    "3": { "$type": "dimension", "$value": 12 },
    "3-5": { "$type": "dimension", "$value": 14 },
    "4": { "$type": "dimension", "$value": 16 },
    "5": { "$type": "dimension", "$value": 20 },
    "6": { "$type": "dimension", "$value": 24 },
    "7": { "$type": "dimension", "$value": 28 },
    "8": { "$type": "dimension", "$value": 32 },
    "10": { "$type": "dimension", "$value": 40 },
    "12": { "$type": "dimension", "$value": 48 },
    "16": { "$type": "dimension", "$value": 64 },
    "20": { "$type": "dimension", "$value": 80 },
    "section": { "$type": "dimension", "$value": 120, "$description": "Vertical rhythm between marketing sections." }
  },

  "size": {
    "control-sm": { "$type": "dimension", "$value": 36, "$description": "App buttons and inputs, compact." },
    "control-md": { "$type": "dimension", "$value": 40, "$description": "App buttons and inputs, default." },
    "control-lg": { "$type": "dimension", "$value": 48, "$description": "Marketing header CTA (was site `md`)." },
    "control-xl": { "$type": "dimension", "$value": 56, "$description": "Marketing hero CTA (was site `lg`)." },
    "container": { "$type": "dimension", "$value": 1280, "$description": "Marketing content column." },
    "container-app": { "$type": "dimension", "$value": 1440, "$description": "Application main column." },
    "sidebar": { "$type": "dimension", "$value": 240 },
    "topbar": { "$type": "dimension", "$value": 60, "$description": "Application top bar." },
    "header": { "$type": "dimension", "$value": 72, "$description": "Marketing header." }
  },

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter", "$description": "Body, UI, forms." },
      "display": { "$type": "fontFamily", "$value": "Space Grotesk", "$description": "Headings, wordmark." },
      "mono": { "$type": "fontFamily", "$value": "JetBrains Mono", "$description": "Machine text: identifiers, logs, JSON, code, token counts. Loaded only on pages that render it." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500, "$description": "Headings, buttons, labels. The brand never goes bolder than 500 in headings." }
    }
  },

  "type": {
    "$description": "Two scales by design. Marketing is fluid (clamp, mobile floor → desktop target). App is fixed: dense screens need predictable sizes. `size` is the desktop value used in Figma.",
    "marketing": {
      "h1": { "family": "display", "weight": 500, "size": 76, "min": 44, "fluid": "clamp(2.75rem, 1.55rem + 4vw, 4.75rem)", "lineHeight": 0.98, "tracking": -0.03 },
      "h2": { "family": "display", "weight": 500, "size": 64, "min": 36, "fluid": "clamp(2.25rem, 1.55rem + 2.4vw, 4rem)", "lineHeight": 0.98, "tracking": -0.03 },
      "h3": { "family": "display", "weight": 500, "size": 36, "min": 24, "fluid": "clamp(1.5rem, 1.25rem + 1vw, 2.25rem)", "lineHeight": 0.98, "tracking": -0.03 },
      "body-lg": { "family": "sans", "weight": 400, "size": 24, "min": 18, "fluid": "clamp(1.125rem, 1rem + 0.6vw, 1.5rem)", "lineHeight": 1.45, "tracking": 0 },
      "body": { "family": "sans", "weight": 400, "size": 18, "min": 16, "fluid": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)", "lineHeight": 1.6, "tracking": 0 },
      "small": { "family": "sans", "weight": 400, "size": 13, "lineHeight": 1.5, "tracking": 0 }
    },
    "app": {
      "page-title": { "family": "display", "weight": 500, "size": 40, "min": 32, "lineHeight": 1.1, "tracking": -0.025 },
      "section-title": { "family": "display", "weight": 500, "size": 22, "lineHeight": 1.2, "tracking": -0.025 },
      "card-title": { "family": "display", "weight": 500, "size": 16, "lineHeight": 1.35, "tracking": -0.025 },
      "body": { "family": "sans", "weight": 400, "size": 15, "lineHeight": 1.5, "tracking": 0 },
      "meta": { "family": "sans", "weight": 400, "size": 13, "lineHeight": 1.45, "tracking": 0, "numeric": "tabular-nums" },
      "id": { "family": "mono", "weight": 400, "size": 13, "lineHeight": 1.45, "tracking": 0, "numeric": "tabular-nums" }
    },
    "mono": {
      "$description": "Machine text. Smaller than the sans body at the same nominal size, because monospace reads larger.",
      "body": { "family": "mono", "weight": 400, "size": 13, "lineHeight": 1.55, "tracking": 0, "$description": "Log lines, prompts, tool arguments" },
      "small": { "family": "mono", "weight": 400, "size": 12, "lineHeight": 1.5, "tracking": 0, "$description": "Dense metadata: timestamps, counts" },
      "id": { "family": "mono", "weight": 500, "size": 13, "lineHeight": 1.45, "tracking": 0, "numeric": "tabular-nums", "$description": "Run and model identifiers, hashes" },
      "code": { "family": "mono", "weight": 400, "size": 13, "lineHeight": 1.6, "tracking": 0, "$description": "Code and JSON blocks" }
    },
    "shared": {
      "eyebrow": { "family": "sans", "weight": 500, "size": 12, "lineHeight": 1.4, "tracking": 0.14, "transform": "uppercase" },
      "label": { "family": "sans", "weight": 500, "size": 15, "lineHeight": 1.4, "tracking": 0, "$description": "Buttons and nav items." }
    }
  },

  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms", "$description": "Nav, tabs, colour-only changes." },
      "base": { "$type": "duration", "$value": "200ms", "$description": "Buttons, inputs." },
      "slow": { "$type": "duration", "$value": "350ms", "$description": "Underline reveal." },
      "reveal": { "$type": "duration", "$value": "700ms", "$description": "Scroll reveal." }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$description": "The brand curve for anything that moves." }
    }
  },

  "shadow": {
    "popover": { "$type": "shadow", "$value": "0 18px 48px -16px rgba(17, 17, 17, 0.35)", "$description": "Only floating layers get a shadow. Cards never do — hierarchy comes from hairlines and spacing." }
  }
}
